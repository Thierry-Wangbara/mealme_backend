# Copy this file to ".env" and fill in your values.

# --- PostgreSQL / Neon ---
# In the Neon console: Connect > Node.js, then copy the pooled connection string.
# Do not commit the real value. Neon SSL is enabled automatically by the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional local PostgreSQL fallback (used only when DATABASE_URL is not set).
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_postgres_password_here
# PGDATABASE=mealme

# --- Server ---
PORT=4000

# --- Firebase ---
# Your Firebase project id (used to verify login tokens). No secret key needed.
FIREBASE_PROJECT_ID=meal-app-a7551
