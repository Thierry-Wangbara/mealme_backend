# Copy this file to ".env" and fill in your values.

# --- PostgreSQL ---
# The password you set when installing PostgreSQL (user "postgres").
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
PGDATABASE=mealme

# --- Server ---
PORT=4000

# --- Firebase ---
# Your Firebase project id (used to verify login tokens). No secret key needed.
FIREBASE_PROJECT_ID=meal-app-a7551
